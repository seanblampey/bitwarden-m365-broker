{
  "name": "bitwarden-m365-broker",
  "version": "0.4.0",
  "keywords": [
    "pi-package",
    "claude-code-plugin",
    "bitwarden",
    "microsoft-365"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
